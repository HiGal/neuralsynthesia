# Nebius AI API Configuration
# Get your API key from https://studio.nebius.ai/
NEBIUS_API_KEY=your_nebius_api_key_here
NEBIUS_BASE_URL=https://api.studio.nebius.ai/v1

# Yandex Cloud Configuration (for Speech-to-Text and Text-to-Speech)
# Get credentials from https://cloud.yandex.com/
OAUTH=your_yandex_oauth_token_here
FOLDER_ID=your_yandex_folder_id_here
